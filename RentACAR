
public abstract class Iznajmljivanje {
   private String imeiPrezime;
   private String datum;
   private int brojDanaIznajmljivanja;
   public static  double osnovnaCijena = 5.00;
   public Iznajmljivanje(String imeiPrezime, String datum, int brojDanaIznajmljivanja) {
	super();
	this.imeiPrezime = imeiPrezime;
	this.datum = datum;
	this.brojDanaIznajmljivanja = brojDanaIznajmljivanja;
   }
   public String getImeiPrezime() {
	return imeiPrezime;
   }
   public void setImeiPrezime(String imeiPrezime) {
	this.imeiPrezime = imeiPrezime;
   }
   public String getDatum() {
	return datum;
   }
   public void setDatum(String datum) {
	this.datum = datum;
   }
   public int getBrojDanaIznajmljivanja() {
	return brojDanaIznajmljivanja;
   }
   public void setBrojDanaIznajmljivanja(int brojDanaIznajmljivanja) {
	this.brojDanaIznajmljivanja = brojDanaIznajmljivanja;
   }
   public abstract double IzracunajCijenu();
}


public class Automobill extends Iznajmljivanje {
     private String marka;
     private int brojSjedista;
     private boolean automatskiMjenjac;
	
	public Automobill(String imeiPrezime, String datum, int brojDanaIznajmljivanja, String marka, int brojSjedista,
			boolean automatskiMjenjac) {
		super(imeiPrezime, datum, brojDanaIznajmljivanja);
		this.marka = marka;
		this.brojSjedista = brojSjedista;
		this.automatskiMjenjac = automatskiMjenjac;
	}

	public String getMarka() {
		return marka;
	}

	public void setMarka(String marka) {
		this.marka = marka;
	}

	public int getBrojSjedista() {
		return brojSjedista;
	}

	public void setBrojSjedista(int brojSjedista) {
		this.brojSjedista = brojSjedista;
	}

	public boolean isAutomatskiMjenjac() {
		return automatskiMjenjac;
	}

	public void setAutomatskiMjenjac(boolean automatskiMjenjac) {
		this.automatskiMjenjac = automatskiMjenjac;
	}

	@Override
	public double IzracunajCijenu() {
		if (automatskiMjenjac == false) {
		 return getBrojDanaIznajmljivanja() * osnovnaCijena * brojSjedista;
	} else {
		return getBrojDanaIznajmljivanja() * osnovnaCijena * brojSjedista * 0.20;
	}
	}
}


public class Motocikll extends Iznajmljivanje {
      private String markaM;
      private int kubikazaM;
      private boolean dodatnaOprema;
	public Motocikll(String imeiPrezime, String datum, int brojDanaIznajmljivanja, String markaM, int kubikazaM,
			boolean dodatnaOprema) {
		super(imeiPrezime, datum, brojDanaIznajmljivanja);
		this.markaM = markaM;
		this.kubikazaM = kubikazaM;
		this.dodatnaOprema = dodatnaOprema;
	}

	public String getMarkaM() {
		return markaM;
	}

	public void setMarkaM(String markaM) {
		this.markaM = markaM;
	}

	public int getKubikazaM() {
		return kubikazaM;
	}

	public void setKubikazaM(int kubikazaM) {
		this.kubikazaM = kubikazaM;
	}

	public boolean isDodatnaOprema() {
		return dodatnaOprema;
	}

	public void setDodatnaOprema(boolean dodatnaOprema) {
		this.dodatnaOprema = dodatnaOprema;
	}

	@Override
	public double IzracunajCijenu() {
		if (dodatnaOprema == false) {
		return getBrojDanaIznajmljivanja() * osnovnaCijena;
	} else {
		return getBrojDanaIznajmljivanja() * osnovnaCijena + 50;
	}

	}
}
